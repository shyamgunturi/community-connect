# Community Connect configuration
# Copy this file to ".env" (same folder) and change values as needed.
# Everything here is OPTIONAL for local development — the app runs without a .env file.

# Port the server listens on (http://localhost:3000)
PORT=3000

# Secret used to sign login tokens (JWT). REQUIRED in production, at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left empty in development, a secret is generated once and stored in data/.dev-jwt-secret
JWT_SECRET=

# How long a login lasts before the user must sign in again
JWT_EXPIRES_IN=7d

# Set to "production" when deploying (makes JWT_SECRET mandatory)
NODE_ENV=development

# SQLite database file (relative to the project folder)
# DATABASE_PATH=data/community-connect.sqlite

# Where uploaded community/event photos are stored
# UPLOAD_DIR=data/uploads
# MAX_UPLOAD_MB=4

# Add the starter communities and events when the database is empty (true/false)
SEED_DEMO_DATA=true
# Optional password so you can log in as the starter organizer (demo-organizer@communityconnect.local)
SEED_ORGANIZER_PASSWORD=

# bcrypt cost factor for password hashing (10-14)
BCRYPT_ROUNDS=12

# Max login/registration attempts per IP every 15 minutes
AUTH_RATE_LIMIT=50

# ---- Location search ----
# postcodes.io (UK open data) powers autocomplete for towns, cities and postcodes.
POSTCODES_API_URL=https://api.postcodes.io
# OpenStreetMap Nominatim is used only as a fallback when you press Search/Enter (never for autocomplete),
# throttled to 1 request per second and cached, as its usage policy requires.
NOMINATIM_ENABLED=true
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Identify the app to the geocoding services. Put a real contact before public deployment.
GEOCODER_USER_AGENT=CommunityConnect-StudentProject/1.0 (local development)
GEOCODER_CONTACT_EMAIL=
GEOCODER_TIMEOUT_MS=6000
# Use a built-in list of ~60 UK towns if the online services are unreachable (true/false)
GEOCODER_OFFLINE_FALLBACK=true

# Set to true only when running behind a reverse proxy (so rate limits see real client IPs)
TRUST_PROXY=false
